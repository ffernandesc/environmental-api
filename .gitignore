# Database files
# =========================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf

# =========================
# App settings / secrets
# =========================
appsettings.Local.json
appsettings.Development.local.json
appsettings.*.local.json
secrets.json
.env
.env.*
!.env.example

# Be careful with these:
# appsettings.Development.json is often committed in dev teams
# appsettings.Production.json should usually NOT contain secrets

