@hostAddress = http://localhost:5135
@apiKey = <your-api-key>

### =========================================================
### Health
### =========================================================

### Health check
GET {{hostAddress}}/

### =========================================================
### Locations
### =========================================================

### Create a location
# @name createLocation
POST {{hostAddress}}/api/locations
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "city": "Braga",
  "district": "Braga",
  "latitude": 41.5454,
  "longitude": -8.4265
}

### Create a location - 401 Unauthorized (missing API key)
POST {{hostAddress}}/api/locations
Content-Type: application/json

{
  "city": "Porto",
  "district": "Porto",
  "latitude": 41.1579,
  "longitude": -8.6291
}

### List all locations
GET {{hostAddress}}/api/locations

### Get location by id
GET {{hostAddress}}/api/locations/{{createLocation.response.body.$.id}}

### Get location by id - 404 Not Found
GET {{hostAddress}}/api/locations/999999

### Update a location
PUT {{hostAddress}}/api/locations/{{createLocation.response.body.$.id}}
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "city": "Braga",
  "district": "Braga",
  "latitude": 41.55,
  "longitude": -8.42
}

### Update a location - 401 Unauthorized (missing API key)
PUT {{hostAddress}}/api/locations/{{createLocation.response.body.$.id}}
Content-Type: application/json

{
  "city": "Braga",
  "district": "Braga",
  "latitude": 41.55,
  "longitude": -8.42
}

### Update a location - 404 Not Found
PUT {{hostAddress}}/api/locations/999999
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "city": "Braga",
  "district": "Braga",
  "latitude": 41.55,
  "longitude": -8.42
}

### Delete a location - 404 Not Found
DELETE {{hostAddress}}/api/locations/999999
X-API-Key: {{apiKey}}

### Delete a location - 401 Unauthorized (missing API key)
DELETE {{hostAddress}}/api/locations/{{createLocation.response.body.$.id}}

### Delete a location
DELETE {{hostAddress}}/api/locations/{{createLocation.response.body.$.id}}
X-API-Key: {{apiKey}}

### =========================================================
### Readings
### =========================================================

### Create a location to attach readings/alerts to
# @name createReadingsLocation
POST {{hostAddress}}/api/locations
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "city": "Braga",
  "district": "Braga",
  "latitude": 41.5454,
  "longitude": -8.4265
}

### Create a reading (values within safe ranges - no alert generated)
# @name createReading
POST {{hostAddress}}/api/readings
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "locationId": {{createReadingsLocation.response.body.$.id}},
  "dateTime": "2026-07-06T10:00:00",
  "temperature": 20,
  "humidity": 50,
  "windSpeed": 10,
  "precipitation": 0,
  "pm10": 10,
  "pm25": 10,
  "europeanAqi": 10
}

### Create a reading (values exceed thresholds - alert generated automatically)
POST {{hostAddress}}/api/readings
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "locationId": {{createReadingsLocation.response.body.$.id}},
  "dateTime": "2026-07-06T10:00:00",
  "temperature": 36,
  "humidity": 92,
  "windSpeed": 55,
  "precipitation": 12,
  "pm10": 110,
  "pm25": 55,
  "europeanAqi": 85
}

### Create a reading - 400 Bad Request (LocationId does not exist)
POST {{hostAddress}}/api/readings
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "locationId": 999999,
  "dateTime": "2026-07-06T10:00:00",
  "temperature": 20,
  "humidity": 50,
  "windSpeed": 10,
  "precipitation": 0,
  "pm10": 10,
  "pm25": 10,
  "europeanAqi": 10
}

### Create a reading - 401 Unauthorized (missing API key)
POST {{hostAddress}}/api/readings
Content-Type: application/json

{
  "locationId": {{createReadingsLocation.response.body.$.id}},
  "dateTime": "2026-07-06T10:00:00",
  "temperature": 20,
  "humidity": 50,
  "windSpeed": 10,
  "precipitation": 0,
  "pm10": 10,
  "pm25": 10,
  "europeanAqi": 10
}

