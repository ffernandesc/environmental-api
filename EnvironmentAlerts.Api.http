### =========================================================
### SOAP - /soap/datalayer.asmx (IDataLayerSoapService)
### =========================================================

### SOAP - GetLocations
POST {{hostAddress}}/soap/datalayer.asmx
Content-Type: text/xml; charset=utf-8
SOAPAction: "https://environmentalerts.api/soap/IDataLayerSoapService/GetLocations"

<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <GetLocations xmlns="https://environmentalerts.api/soap" />
  </soap:Body>
</soap:Envelope>

### SOAP - GetLocationById
POST {{hostAddress}}/soap/datalayer.asmx
Content-Type: text/xml; charset=utf-8
SOAPAction: "https://environmentalerts.api/soap/IDataLayerSoapService/GetLocationById"

<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <GetLocationById xmlns="https://environmentalerts.api/soap">
      <id>1</id>
    </GetLocationById>
  </soap:Body>
</soap:Envelope>

### SOAP - GetAlerts
POST {{hostAddress}}/soap/datalayer.asmx
Content-Type: text/xml; charset=utf-8
SOAPAction: "https://environmentalerts.api/soap/IDataLayerSoapService/GetAlerts"

<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <GetAlerts xmlns="https://environmentalerts.api/soap" />
  </soap:Body>
</soap:Envelope>

### SOAP - GetAlertsByLocation
POST {{hostAddress}}/soap/datalayer.asmx
Content-Type: text/xml; charset=utf-8
SOAPAction: "https://environmentalerts.api/soap/IDataLayerSoapService/GetAlertsByLocation"

<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <GetAlertsByLocation xmlns="https://environmentalerts.api/soap">
      <locationId>1</locationId>
    </GetAlertsByLocation>
  </soap:Body>
</soap:Envelope>
